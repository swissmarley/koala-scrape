{
  "manifest_version": 3,
  "name": "KoalaScrape",
  "short_name": "KoalaScrape",
  "version": "3.0.0",
  "description": "Point-and-click web scraper with smart list detection, a UiPath-style element explorer, pagination and Excel/CSV/JSON export.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "unlimitedStorage", "downloads", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open KoalaScrape",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open KoalaScrape"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
